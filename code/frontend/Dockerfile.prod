# 生产前端镜像：Vite 构建后交给 Nginx 静态托管，并反向代理 /api。
#
# 两阶段：build 阶段有 Node、node_modules 和源码；运行阶段只留 dist。
# 构建上下文是仓库根 code/，这样可以同时拿到 frontend/ 与
# ops/deploy/nginx-edge.conf；镜像里不保留 node_modules 和源码。

# 国内网络默认走镜像站；境外构建可用 --build-arg NODE_IMAGE=node:22-alpine 覆盖。
ARG NODE_IMAGE=docker.1ms.run/library/node:22-alpine
ARG NGINX_IMAGE=docker.1ms.run/library/nginx:1.27-alpine

FROM ${NODE_IMAGE} AS build

ARG NPM_CONFIG_REGISTRY=https://registry.npmmirror.com

WORKDIR /src

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --registry="${NPM_CONFIG_REGISTRY}" --no-audit --no-fund

COPY frontend/ ./
RUN npm run build \
 && find dist -type f -name '*.map' -delete

FROM ${NGINX_IMAGE}

COPY ops/deploy/nginx-edge.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=15s --timeout=5s --retries=5 \
    CMD wget -q -O- http://127.0.0.1/healthz || exit 1

CMD ["nginx", "-g", "daemon off;"]
