# 环境变量样例。复制成 .env 后启动服务。
#
# 全部是本地样例值，不连接真实环境、公网或生产。
# 真实地址、账号和网段在部署时通过配置页填写，不写进代码或本文件。
# 凭据只从环境变量注入，程序用完即弃，不进日志、报告、前端、报错信息。
#
# 用法：
#   cp .env.example .env
#   docker compose up
# .env 已由 .gitignore 排除；填了真值的文件保存在本机。

# ---------- 运行环境 ----------
# test：测试环境，允许测试短信通道和样例数据。
# production：生产环境，固定真实执行；由生产 Compose 内置，不在这里手工填。
APP_ENV=test

# ---------- 凭据：SOPS + age（生产默认） ----------
# 敏感键不写在这个文件里。把数据库口令、令牌密钥、CRED_* 等放进
# secrets.encrypted.env（SOPS 加密），启动时由 config.load_dotenv() 解密注入进程环境。
# 私钥 age.key 放在本机受限目录。
# 三项留空时只读 .env；生产环境使用独立配置。
SOPS_SECRETS_FILE=secrets.encrypted.env
SOPS_AGE_KEY_FILE=var/secrets/age.key
SOPS_BIN=var/tools/sops.exe
# Prometheus 抓取令牌。为空时 /api/metrics 只允许本机回环访问；
# 生产建议设成随机串，并让抓取端带 X-Metrics-Token 头。
METRICS_TOKEN=
LOG_LEVEL=INFO
APP_NAME=运维 Agent 平台 · 后台

# ---------- 后台监听 ----------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# ---------- 前端 / 桌面 ----------
# 前端服务地址，也是 Electron 加载的地址
CORS_ORIGINS=http://127.0.0.1:5173
FRONTEND_URL=http://127.0.0.1:5173
# 飞书/邮件通知里的任务链接前缀；留空则用 FRONTEND_URL
NOTIFY_BASE_URL=
# Vite 把 /api 转发到后台的地址
BACKEND_TARGET=http://127.0.0.1:8000

# ---------- 本地依赖容器（全部是样例值） ----------
# 一共五个数据库身份，各自负责不同权限（缺哪个对应功能就起不来）：
#   DB_ADMIN_URL         管理账号，只有初始化脚本能用（建表、建角色、授权）
#   DATABASE_URL         应用账号 ops_app，日常业务；对审计表【只有 INSERT】
#   DB_AUDIT_READER_URL  审计只读账号，只用来按 trace_id 查账本
#   DB_AUTH_URL          认证专属账号，只登录校验用
#   DB_USER_ADMIN_URL    用户管理专用账号，只给 /api/admin 用
# 连接串里的密码只在本机 .env 中，不进入代码、日志和报告。
DB_ADMIN_URL=postgresql://fake_ops:fake_password_do_not_use@127.0.0.1:5432/fake_opsdb
DATABASE_URL=postgresql://ops_app:fake_app_password_do_not_use@127.0.0.1:5432/fake_opsdb
DB_AUDIT_READER_URL=postgresql://ops_audit_reader:fake_reader_password_do_not_use@127.0.0.1:5432/fake_opsdb
DB_APP_ROLE=ops_app
DB_AUDIT_READER_ROLE=ops_audit_reader
DB_APP_PASSWORD=fake_app_password_do_not_use
DB_AUDIT_READER_PASSWORD=fake_reader_password_do_not_use

# ---------- 登录与权限（全部是样例值） ----------
# 第四个身份的连接串在这里：认证专属账号，只登录校验用。
# 认证表（密码哈希/TOTP/短信码）归它管；应用主账号对认证表【零权限】。
DB_AUTH_URL=postgresql://ops_auth:fake_auth_password_do_not_use@127.0.0.1:5432/fake_opsdb
DB_AUTH_ROLE=ops_auth
DB_AUTH_PASSWORD=fake_auth_password_do_not_use

# 第五个身份：用户管理专用账号。只给 /api/admin 的账号管理服务用。
# 它能写用户资料、认证凭据、手机绑定，并向审计表追加事件；worker 和日常接口使用各自的最小权限账号。
DB_USER_ADMIN_URL=postgresql://ops_user_admin:fake_user_admin_password_do_not_use@127.0.0.1:5432/fake_opsdb
DB_USER_ADMIN_ROLE=ops_user_admin
DB_USER_ADMIN_PASSWORD=fake_user_admin_password_do_not_use

# 会话令牌（JWT）签名密钥：换成你自己的随机值（python -c "import secrets;print(secrets.token_hex(32))"）
AUTH_TOKEN_SECRET=fake_jwt_secret_change_me
# 会话令牌（JWT）有效期：480 分钟 = 8 小时
AUTH_TOKEN_TTL_MINUTES=480

# TOTP：发行方名称 + 密钥加密 key（Fernet 格式，换法：
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"）
AUTH_TOTP_ISSUER=ops-agent-dev
TOTP_ENCRYPTION_KEY=replace_with_your_fernet_key=

# 数据库加密凭据 key（Fernet 格式）。与 TOTP key 分开，丢了密文就解不开。
# 生成：python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=replace_with_your_cred_fernet_key=

# 短信通道：test = 测试通道（验证码会在接口回显 dev_code）
# 上线前换真实通道：改这里 + 在 backend/app/core/sms.py 注册实现类
# 【硬约束】APP_ENV=production 且 SMS_CHANNEL=test 时后台会拒绝启动 ——
# 测试通道会回显验证码，跟着生产一起上线等于开放登录。
SMS_CHANNEL=test
SMS_CODE_TTL_SECONDS=300

# Alertmanager Webhook：POST /api/alerts/alertmanager，Bearer 令牌放在
# Authorization: Bearer <token>。为空时接口返回 503（失败关闭）。
# 生产用随机长串；请求体上限默认 64 KiB，按告警批量大小调整。
ALERT_WEBHOOK_TOKEN=
ALERT_WEBHOOK_MAX_BYTES=65536

# 连续登录失败几次锁账号、锁多久（防爆破）
LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_MINUTES=15

# 管理员账号（首次部署后应改掉密码）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=fake_admin_password_do_not_use
ADMIN_PHONE=13800000000

# 密码哈希轮数（测试机可以调低加速测试，生产建议 100000 以上）
PBKDF2_ROUNDS=100000

# 缓存
# 生产环境需要配置 Redis：执行许可 nonce 去重依赖 Redis SET NX EX，缺失时执行被拒绝。
REDIS_URL=redis://127.0.0.1:6379/0

# 队列：根因排查和部署两条队列分开，不共用一个通道
MQ_URL=amqp://fake_ops:fake_password_do_not_use@127.0.0.1:5672/
MQ_MANAGEMENT_URL=http://127.0.0.1:15672
MQ_USER=fake_ops
MQ_PASSWORD=fake_password_do_not_use
MQ_QUEUE_INVESTIGATION=ops.investigation
MQ_QUEUE_DEPLOYMENT=ops.deployment

# 部署执行实时日志（SSE）：默认开启；执行器逐行回传，页面实时展示。
# 后端与队列 worker 同时设置该值，只影响部署 apply/verify/rollback。
EXEC_STREAM_ENABLED=true

# 数据库连接池：默认开；排障时可临时设 DB_POOL_ENABLED=false 退回直连
DB_POOL_MIN=1
DB_POOL_MAX=8

# 接口限流：默认开。只挡两个入口，其余接口不设配额。
# 注意：计数在进程内存里，多副本部署时每个副本各算一份配额；
# 要真控住请换共享计数（Redis），并只在可信代理后面才开 RATE_LIMIT_TRUST_XFF。
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MIN=10
RATE_LIMIT_TASKS_PER_MIN=20
RATE_LIMIT_TRUST_XFF=false

# 对象存储（存放报告和证据）
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_BUCKET=ops-agent-artifacts
# 排查截图原图私有桶；不配则退回数据库 bytea（仅兼容模式）
MINIO_SCREENSHOT_BUCKET=ops-agent-screenshots

# 审计归档：使用单独的、开启对象锁的桶
#   * 这个桶的创建方式是 `mc mb --with-lock`，建完才能设默认保留期；
#   * 保留期单位是天，COMPLIANCE 模式下管理员也删不掉，超期即可删；
#   * 没配 MINIO_ENDPOINT 时归档落本地目录（临时使用），可用 AUDIT_ARCHIVE_DIR 改位置。
MINIO_AUDIT_BUCKET=ops-agent-audit
AUDIT_RETENTION_DAYS=90
# AUDIT_ARCHIVE_DIR=

# 跨平台命令执行工具（默认关闭）
#   * 打开后 Agent 才会拿到 run_command 工具，但能不能跑由四道门决定：
#     白名单 → 执行许可 → 高危人工确认 → 超时/输出上限；
#   * EXEC_PERMIT_SECRET 至少 32 字符，后台签发令牌与 worker 验签共用；
#     缺它或长度不够时执行被拒绝（默认关闭，不降级放行）；
#   * 审计 JSONL 只记指纹/耗时/退出码，不记命令明文。
EXEC_TOOL_ENABLED=false
EXEC_PERMIT_SECRET=
EXEC_AUDIT_LOG=var/logs/exec-audit.jsonl

# 假中间件账号（compose 起 infra 时用，全是演示用假值）
POSTGRES_USER=fake_ops
POSTGRES_PASSWORD=fake_password_do_not_use
POSTGRES_DB=fake_opsdb
RABBITMQ_USER=fake_ops
RABBITMQ_PASSWORD=fake_password_do_not_use
MINIO_USER=fake_ops
MINIO_PASSWORD=fake_password_do_not_use

# ---------- 真排查 Agent（AgentScope + DeepSeek）----------
# 这两个只在【运行时】从环境读，README 和代码里不写死值。
# DEEPSEEK_LIVE_KEY 是真实 API Key，保存在本机配置中；日志不记录其内容。
# 用法（本机临时设置，用完就关掉终端）：
#   DEEPSEEK_LIVE_KEY=你的密钥 DEEPSEEK_BASE_URL=https://api.deepseek.com/v1 \
#     ./backend/.venv/Scripts/python.exe worker/agent_live.py
# 真连会产生少量费用和一次数据出境；不设置这两个变量时，脚本会明确拒绝运行，
# 不会偷偷拿假模型顶替。
# DEEPSEEK_LIVE_KEY=
# DEEPSEEK_BASE_URL=

# 配置页模型配置里的 credential_ref 是「引用名」，凭据层默认映射成
# CRED_ + 大写引用名。例如 credential_ref=LLM_API_KEY 时读 CRED_LLM_API_KEY。
# 不想改名就在 credential 配置的 env_ref_map 里做显式映射。
# CRED_LLM_API_KEY=
# LiteLLM 虚拟 key 的引用名示例（生产只放虚拟 key，不放上游真 key）
# CRED_LITELLM_VIRTUAL_KEY=

# 出网白名单（精确主机名，逗号分隔；支持多个）。
# 留空时拒绝执行，不因未配置而放行。
# 生产路径：由后台从「配置页 → 大模型网关 → domain_allowlist」读取后随任务传给 worker；
# 这一行只给本机手工运行 agent_live.py 时使用。
LLM_DOMAIN_ALLOWLIST=

# ---------- 凭据引用解析（样例值） ----------
# 配置表里只存引用名 demo_ref，真实值运行期按 CRED_ + 大写 + 下划线去找。
# 这一行只给本地脚本路径使用：容器编排是显式白名单，不会透传 CRED_*，
# 容器里解析结果就是「无数据」，绝不会显示成「正常」。
# 生产可把引用名指向 OpenBao 静态 KV 路径或 SOPS+age 加密文件。
CRED_DEMO_REF=fake_credential_value_for_selftest_only

# ---------- OpenBao 静态 KV（默认走数据库加密） ----------
# 默认 backend=db 时不需要这些变量；只有 backend=openbao 时才配置。
# 只读令牌用于解析凭据；写令牌只用于回滚后配置页「设置数据源密码」，两者建议分开授权。
# 令牌也可以放进文件（容器 secret mount）；数据库配置行只保存引用。
OPENBAO_TOKEN=
OPENBAO_TOKEN_FILE=
OPENBAO_WRITE_TOKEN=
OPENBAO_WRITE_TOKEN_FILE=

# ---------- SSH 主机公钥（默认值） ----------
# strict：只认已登记；prompt：首次未登记可人工确认；off：仅测试环境。
SSH_HOST_KEY_POLICY=prompt
# 相对路径按 code/ 解析；容器里由 Compose 覆盖为 /srv/ssh/known_hosts。
SSH_KNOWN_HOSTS_FILE=var/ssh/known_hosts
# 只有 off 策略需要；不设则 worker 直接拒绝。
SSH_HOST_KEY_INSECURE_ACK=
