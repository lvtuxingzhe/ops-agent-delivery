# 生产环境变量模板。
#
# 用法：
#   cp .env.production.example .env.production
#   # 把 CHANGE_ME / REPLACE_ME 全部换掉，权限 chmod 600
#   bash ops/deploy/deploy.sh
#
# 这份文件只放宿主机；不要提交真实密码、模型 Key 或 webhook 令牌。

# ---------- 入口 ----------
# 宿主机对外端口；TLS 由前置 Nginx / 负载均衡终止。
EDGE_PORT=8080
# 镜像标签；必须与本地 tar 导入的标签一致。本次交付使用 2026.11.22。
OPS_IMAGE_TAG=2026.11.22
# 1=部署前自动拉取 PostgreSQL/Redis/MinIO 依赖镜像；0=目标机离线时跳过。
OPS_PULL_BASE_IMAGES=1
# 依赖镜像默认走国内镜像站，版本已固定；能直连 Docker Hub 时改成官方镜像名。
POSTGRES_IMAGE=docker.1ms.run/pgvector/pgvector:0.8.0-pg16
REDIS_IMAGE=docker.1ms.run/library/redis:7.4.12-alpine
MINIO_IMAGE=swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/minio/minio:RELEASE.2025-03-12T18-04-18Z
MINIO_CLIENT_IMAGE=swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/minio/mc:RELEASE.2025-03-12T17-29-24Z
# 值里有空格，必须加引号；deploy.sh 读取时不会执行 shell。
APP_NAME="运维 Agent 平台"
# 生产环境由 docker-compose.prod.yml 固定为 APP_ENV=production，
# 不再要求在这里填 APP_MODE 或 REAL_MODE_ACK。

# SMS 登录关闭时用 disabled；只用账号密码 + TOTP。真实短信通道必须先实现。
SMS_CHANNEL=disabled
SMS_CODE_TTL_SECONDS=300

# ---------- PostgreSQL ----------
POSTGRES_USER=ops_root
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=opsdb

DB_APP_ROLE=ops_app
DB_APP_PASSWORD=CHANGE_ME_OPS_APP_PASSWORD
DB_AUDIT_READER_ROLE=ops_audit_reader
DB_AUDIT_READER_PASSWORD=CHANGE_ME_OPS_AUDIT_READER_PASSWORD
DB_AUTH_ROLE=ops_auth
DB_AUTH_PASSWORD=CHANGE_ME_OPS_AUTH_PASSWORD
DB_USER_ADMIN_ROLE=ops_user_admin
DB_USER_ADMIN_PASSWORD=CHANGE_ME_OPS_USER_ADMIN_PASSWORD

# 下面四行必须来自独立随机值；AUTH_TOKEN_SECRET / EXEC_PERMIT_SECRET
# 至少 40 个字符。可以用 openssl rand -hex 32 生成。
AUTH_TOKEN_SECRET=REPLACE_ME_64_RANDOM_CHARS
AUTH_TOKEN_TTL_MINUTES=480
AUTH_TOTP_ISSUER=ops-agent
# Fernet key：python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
TOTP_ENCRYPTION_KEY=REPLACE_ME_FERNET_KEY
# 数据库加密凭据 key：与 TOTP key 分开，丢了密文就解不开。
CREDENTIAL_ENCRYPTION_KEY=REPLACE_ME_CRED_FERNET_KEY
EXEC_PERMIT_SECRET=REPLACE_ME_64_RANDOM_CHARS

# ---------- OpenBao 静态 KV（仅回滚保留；默认走数据库加密） ----------
# 默认 backend=db 时不需要这些变量。只有回滚到 backend=openbao 才配置。
# 只读令牌用于任务解析凭据；写令牌只给配置页写密码用，建议分开授权。
# 回滚时首次加这两项需要重建 backend/worker 容器；之后改密码不需要再重启。
OPENBAO_TOKEN=
OPENBAO_TOKEN_FILE=
OPENBAO_WRITE_TOKEN=
OPENBAO_WRITE_TOKEN_FILE=

LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_MINUTES=15
PBKDF2_ROUNDS=100000

# ---------- 管理员账号 ----------
# 首次部署会创建；登录后立刻改密码并绑 TOTP。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
ADMIN_PHONE=13800000000

# ---------- Redis / MinIO ----------
MINIO_ROOT_USER=ops_minio
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD
# 应用账号与 root 相同即可；后续可换成独立只读/读写账号。
MINIO_USER=ops_minio
MINIO_PASSWORD=CHANGE_ME_MINIO_PASSWORD
MINIO_BUCKET=ops-agent-artifacts
MINIO_SCREENSHOT_BUCKET=ops-agent-screenshots
MINIO_AUDIT_BUCKET=ops-agent-audit
AUDIT_RETENTION_DAYS=90

# ---------- 告警 Webhook ----------
# POST /api/alerts/alertmanager，Authorization: Bearer <token>
ALERT_WEBHOOK_TOKEN=REPLACE_ME_RANDOM_WEBHOOK_TOKEN
ALERT_WEBHOOK_MAX_BYTES=65536

# ---------- 可观测性 ----------
METRICS_TOKEN=REPLACE_ME_RANDOM_METRICS_TOKEN
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:8080

# ---------- 模型 ----------
# 仅 worker 使用；不填则排查任务会如实报模型不可用，不会伪造结果。
DEEPSEEK_BASE_URL=
DEEPSEEK_LIVE_KEY=

# ---------- SSH 主机公钥 ----------
# strict：只认已登记；prompt：首次未登记可弹窗确认（默认）；off：仅测试环境。
# 配置页的“主机公钥校验”会写入数据库并优先生效；这里只是首次默认值。
SSH_HOST_KEY_POLICY=prompt
# 只有策略为 off 时才需要；不设则 worker 直接拒绝。
SSH_HOST_KEY_INSECURE_ACK=
# 容器内路径，不要改；宿主机文件是 var/ssh/known_hosts。
SSH_KNOWN_HOSTS_FILE=/srv/ssh/known_hosts
